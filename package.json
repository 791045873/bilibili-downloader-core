{
  "name": "bilibili-downloader-core",
  "private": true,
  "description": "Bilibili 下载引擎 - 可嵌入多种运行形态的核心下载能力",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r dev",
    "typecheck": "pnpm -r typecheck",
    "download": "pnpm --filter @bilibili-downloader/cli start:download",
    "login-bili": "pnpm --filter @bilibili-downloader/cli start:login",
    "history": "pnpm --filter @bilibili-downloader/cli start:history",
    "setup": "pnpm --filter @bilibili-downloader/cli start:install",
    "docker:build": "pnpm --filter @bilibili-downloader/docker docker:build",
    "docker:run": "pnpm --filter @bilibili-downloader/docker docker:run",
    "server:start": "pnpm --filter @bilibili-downloader/server start",
    "frontend:dev": "pnpm --filter @bilibili-downloader/frontend dev",
    "frontend:build": "pnpm --filter @bilibili-downloader/frontend build",
    "dev:server": "pnpm build:deps && concurrently -n server,frontend -c blue,green \"pnpm --filter @bilibili-downloader/server start:dev\"",
    "dev:deps": "pnpm --filter @bilibili-downloader/core --filter @bilibili-downloader/adapters --filter @bilibili-downloader/cli --filter @bilibili-downloader/server build",
    "build:deps": "pnpm --filter @bilibili-downloader/core --filter @bilibili-downloader/adapters build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-var": "^1.1.0"
  }
}