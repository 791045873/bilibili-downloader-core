{
  "name": "bilibili-api-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Bilibili unofficial REST APIs (wild APIs), built from bilibili-API-collect docs and the BiliPai client implementation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "API.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "bilibili",
    "b站",
    "api",
    "sdk",
    "wbi",
    "videostream",
    "danmaku"
  ],
  "license": "CC-BY-NC-4.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
