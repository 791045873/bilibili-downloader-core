{
  "name": "@bilibili-downloader/server",
  "version": "0.0.1",
  "description": "NestJS Web 服务器 - Bilibili 下载器管理界面",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:vision-proxy": "node ../../scripts/start-vision-proxy.mjs",
    "start:prod": "node --env-file=.env dist/main",
    "migrate:sqlite-to-pg": "node --env-file=.env scripts/migrate-sqlite-to-postgres.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "lodash": "^4.18.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.9",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.0",
    "better-sqlite3": "^12.10.0",
    "typescript": "^5.7.0"
  }
}