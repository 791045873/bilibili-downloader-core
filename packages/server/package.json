{
  "name": "@bilibili-downloader/server",
  "version": "0.0.1",
  "description": "NestJS Web 服务器 - Bilibili 下载器管理界面",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file=.env dist/main",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "better-sqlite3": "^12.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}