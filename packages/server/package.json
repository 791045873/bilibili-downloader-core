{
  "name": "@bilibili-downloader/server",
  "version": "0.0.1",
  "description": "Docker Web 服务器 - Bilibili 下载器管理界面",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "build:bundle": "node build-server.mjs",
    "clean": "tsc -b --clean && rm -rf bin",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}