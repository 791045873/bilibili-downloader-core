{
  "name": "@bilibili-downloader/cli",
  "version": "0.0.1",
  "description": "CLI 运行时入口 - 命令行下载工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bili-dl": "./bin/bili-dl.cjs"
  },
  "files": [
    "bin/bili-dl.cjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:bundle": "node build-bundle.mjs",
    "build:server": "node build-server.mjs",
    "build:docker": "pnpm build && pnpm build:server && docker build -t bilibili-downloader .",
    "clean": "tsc -b --clean && rm -rf bin",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}