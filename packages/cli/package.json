{
  "name": "@bilibili-downloader/cli",
  "version": "0.0.1",
  "description": "CLI 运行时入口 - 命令行下载工具",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bili-dl": "./bin/bili-dl.cjs"
  },
  "files": [
    "bin/bili-dl.cjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:bundle": "node build-bundle.mjs",
    "clean": "tsc -b --clean && rm -rf bin",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b",
    "start:download": "node dist/index.js download",
    "start:login": "node dist/index.js login",
    "start:history": "node dist/index.js history",
    "start:install": "node dist/index.js install"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}