{
  "name": "@bilibili-downloader/cloud-server",
  "version": "0.0.1",
  "description": "云端对外 HTTP API（Phase 3 拆分：parse/download 创建读取/analysis 触发查询/chat-RAG/knowledge/prompt/settings/auth/作业生产）",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "prisma:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bilibili-downloader/adapters": "workspace:*",
    "@bilibili-downloader/core": "workspace:*",
    "@bilibili-downloader/server-common": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "lodash": "^4.18.1",
    "multer": "^2.3.0",
    "openai": "^7.25.0",
    "prisma": "8.0.0-rc.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
