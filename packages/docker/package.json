{
  "name": "@bilibili-downloader/docker",
  "version": "0.0.1",
  "private": true,
  "description": "Docker 镜像打包 — 用三个独立 Dockerfile（Dockerfile.cloud-server / Dockerfile.nas-worker / Dockerfile.vision-proxy）分别构建 cloud-server（对外 HTTP + 前端静态）、nas-worker（作业执行 + ffmpeg）、vision-proxy（Python 视觉代理）三个相互独立的镜像，经 docker compose 编排；镜像 tag 取对应包 version（compose.mjs 自动推导，CLOUD_SERVER_VERSION / NAS_WORKER_VERSION / VISION_PROXY_VERSION 可覆盖）",
  "scripts": {
    "docker:build": "node compose.mjs build",
    "docker:build:cloud-server": "node compose.mjs build-cloud-server",
    "docker:build:nas-worker": "node compose.mjs build-nas-worker",
    "docker:build:vision-proxy": "node compose.mjs build-vision-proxy",
    "docker:save": "node compose.mjs save",
    "docker:save:cloud-server": "node compose.mjs save-cloud-server",
    "docker:save:nas-worker": "node compose.mjs save-nas-worker",
    "docker:save:vision-proxy": "node compose.mjs save-vision-proxy",
    "docker:run": "node compose.mjs up -d",
    "docker:down": "node compose.mjs down",
    "docker:logs": "node compose.mjs logs -f --no-log-prefix",
    "docker:config": "node compose.mjs config",
    "docker:cloud:up": "node compose.mjs -f docker-compose.cloud.yml up -d",
    "docker:cloud:down": "node compose.mjs -f docker-compose.cloud.yml down",
    "docker:cloud:logs": "node compose.mjs -f docker-compose.cloud.yml logs -f --no-log-prefix",
    "docker:cloud:config": "node compose.mjs -f docker-compose.cloud.yml config",
    "docker:nas:up": "node compose.mjs -f docker-compose.nas.yml up -d",
    "docker:nas:down": "node compose.mjs -f docker-compose.nas.yml down",
    "docker:nas:logs": "node compose.mjs -f docker-compose.nas.yml logs -f --no-log-prefix",
    "docker:nas:config": "node compose.mjs -f docker-compose.nas.yml config"
  }
}
